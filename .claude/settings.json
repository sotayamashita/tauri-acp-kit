{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm run lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm run lint:fix)",
      "Bash(pnpm fmt)",
      "Bash(pnpm run fmt)",
      "Bash(pnpm fmt:check)",
      "Bash(pnpm run fmt:check)",
      "Bash(cargo check:*)",
      "Bash(cargo fmt)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "mise x -- node \"$CLAUDE_PROJECT_DIR/.claude/hooks/oxlint.js\""
          }
        ],
        "description": "Run oxlint --fix on src/ and packages/ JS/TS files after edits"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "mise x -- node \"$CLAUDE_PROJECT_DIR/.claude/hooks/oxfmt.js\""
          }
        ],
        "description": "Run oxfmt on src/ and packages/ JS/TS files after edits"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "mise x -- node \"$CLAUDE_PROJECT_DIR/.claude/hooks/tsc.js\""
          }
        ],
        "description": "Run tsc --noEmit on src/ and packages/ TS files after edits"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "mise x -- node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cargo-fmt.js\""
          }
        ],
        "description": "Run cargo fmt on src-tauri/ and crates/ Rust files after edits"
      }
    ]
  }
}
