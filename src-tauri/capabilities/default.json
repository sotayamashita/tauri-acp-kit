{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "acp:allow-acp-spawn-agent",
    "acp:allow-acp-start-session",
    "acp:allow-acp-send-prompt",
    "acp:allow-acp-cancel",
    "acp:allow-acp-set-model",
    "acp:allow-acp-respond-permission",
    "acp:allow-acp-terminate-agent",
    "acp:allow-acp-check-agent-available",
    "acp:allow-acp-check-agent",
    "acp:allow-acp-download-agent",
    "acp:allow-acp-get-agent-registry",
    "acp:allow-acp-get-cli-version"
  ]
}
